<%- include('Partials/Head') %>

<body class="bg-slate-100 min-h-screen">

<%- include('Partials/Header') %>

<main class="max-w-7xl mx-auto px-6 py-10">

    <!-- Hero -->
    <section class="bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-500 rounded-3xl shadow-xl p-8 mb-10">

        <div class="flex flex-col lg:flex-row justify-between items-center gap-6">

            <div>

                <h1 class="text-4xl md:text-5xl font-bold text-white">
                    🏡 Registered Houses
                </h1>

                <p class="text-blue-100 mt-3 text-lg">
                    Discover premium houses available for rent.
                </p>

            </div>

            <a
                href="/host/showHome"
                class="bg-white text-blue-700 px-6 py-3 rounded-xl font-semibold shadow hover:bg-blue-50 transition duration-300">
                🏠 Go to Registered Houses
            </a>

        </div>

    </section>

    <!-- House Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

        <% if(userData.length===0){ %>

        <div class="col-span-full">

            <div class="bg-white rounded-2xl shadow-lg p-16 text-center">

                <h2 class="text-3xl font-bold text-gray-700">
                    😔 No Houses Registered
                </h2>

                <p class="text-gray-500 mt-4">
                    Register your first property to see it listed here.
                </p>

                <a
                    href="/"
                    class="inline-block mt-6 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold transition">
                    Register House
                </a>

            </div>

        </div>

        <% } %>

        <% userData.forEach(Data=>{ %>

        <!-- Card -->
        <div class="max-w-sm mx-auto bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">

            <!-- Image -->
            <div class="relative">

                <img
                    src="https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=900"
                    alt="House"
                    class="w-full h-48 object-cover">

                <!-- Dark Overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

                <!-- Status Badge -->
                 <% if( !(allBooking.find((home)=> home.id === Data.id))  &&  (Data.available == 'on')  ){ %>

                <span class="absolute top-3 left-3 bg-green-600 text-white text-xs font-semibold px-3 py-1 rounded-full shadow">
                    Available
                </span>

                <% } else { %>

                <span class="absolute top-3 left-3 bg-red-600 text-white text-xs font-semibold px-3 py-1 rounded-full shadow">
                    Booked
                </span>

                <% } %>

                <!-- Favourite -->
                <form
                    action="/user/removeFavourite"
                    method="POST"
                    class="absolute top-3 right-3">

                    <button
                        type="submit"
                        class="cursor-pointer w-10 h-10 rounded-full bg-red-500 backdrop-blur flex items-center justify-center shadow-lg hover: hover:text-white transition-all duration-300">

                        <svg xmlns="http://www.w3.org/2000/svg"
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            viewBox="0 0 24 24">

                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5A5.5 5.5 0 017.5 3 5.5 5.5 0 0112 5.09 5.5 5.5 0 0116.5 3 5.5 5.5 0 0122 8.5c0 3.78-3.4 6.86-8.55 11.54z"/>

                        </svg>

                    </button>

                    <input type="hidden" name="id" value="<%= Data.id %>">

                </form>

            </div>

             <a
                            href="/host/showHome/<%= Data.id %>"
                            class="cursor-pointer px-4 py-2 rounded-lg border border-blue-200 text-purple-600 hover:bg-purple-600 hover:text-white transition font-medium">

                            Details

                        </a>

            <!-- Body -->
            <div class="p-5">

                <div class="flex justify-between items-start">

                    <div>

                        <h2 class="text-xl font-bold text-gray-900">
                            <%= Data.houseName %>
                        </h2>

                        <p class="text-sm text-gray-500 mt-1">
                             <%= Data.location %>
                        </p>

                    </div>

                    <div class="text-right">

                        <p class="text-2xl font-bold text-blue-600">
                            ₹<%= Data.rent %>
                        </p>

                        <span class="text-xs text-gray-400">
                            per month
                        </span>

                    </div>

                </div>

                <div class="my-4 border-t"></div>

                <div class="space-y-2 text-sm text-gray-700">

                    <p>
                        👤 <span class="font-semibold">Owner:</span>
                        <%= Data.owner %>
                    </p>

                    <p>
                        🛏️ <span class="font-semibold">
                            <%= Data.bedrooms %> BHK
                        </span>
                    </p>

                    <p class="text-gray-600 line-clamp-2">
                        <%= Data.description %>
                    </p>
                </div>

                 <% if( !(allBooking.find((home)=> home.id === Data.id))  ){ %>
                <!-- Action Buttons -->
                <div class="grid grid-cols-2 gap-3 mt-5">                    <!-- Book -->
                   
                   <% } else {%>
                <div class="grid grid-cols-1 gap-3 mt-5">   
                    
                        <% } %>

                    <% if( !(allBooking.find((home)=> home.id === Data.id))  &&  (Data.available == 'on') ){ %>
                   
                       
                    <form
                        action="/user/bookHome/<%= Data.id %>"
                        method="POST">

                        <button
                            type="submit"
                            class="cursor-pointer w-full py-2 rounded-lg border border-yellow-300 text-yellow-600 hover:bg-yellow-500 hover:text-white text-sm font-medium transition-all duration-300">

                            Book

                        </button>

                    </form>



                     <!-- Delete -->
                    <form
                        action="/user/removeFavourite"
                        method="POST">

                        <button
                            type="submit"
                            class="cursor-pointer w-full py-2 rounded-lg border border-red-300 text-red-600 hover:bg-red-600 hover:text-white text-sm font-medium transition-all duration-300">

                            Remove

                        </button>
                        <input type="hidden" name="id" value="<%= Data.id %>">

                    </form>





                   <%} else if( !(allBooking.find((home)=> home.id === Data.id))  &&  !(Data.available == 'on')  ){ %>


                    <div class="text-center text-red-600 flex items-center justify-center">
                        <p>Not Available</p>
                    </div>

              


                <form
                        action="/user/removeFavourite"
                        method="POST">

                        <button
                            type="submit"
                            class="cursor-pointer w-full py-2 rounded-lg border border-red-300 text-red-600 hover:bg-red-600 hover:text-white text-sm font-medium transition-all duration-300">

                            Remove

                        </button>
                        <input type="hidden" name="id" value="<%= Data.id %>">

                    </form>




                    <% } else {%>

                       
                        <form
                        action="/user/removeFavourite"
                        method="POST">

                        <button
                            type="submit"
                            class="cursor-pointer w-full py-2 rounded-lg border border-red-300 text-red-600 hover:bg-red-600 hover:text-white text-sm font-medium transition-all duration-300">

                            Remove

                        </button>
                        <input type="hidden" name="id" value="<%= Data.id %>">

                    </form>


                    <% } %>

                   

                   

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</main>

</body>

</html>