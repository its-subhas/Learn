<%- include('Partials/Head') %>

<body class="bg-slate-100 min-h-screen">

<%- include('Partials/Header') %>

<main class="max-w-7xl mx-auto px-6 py-10">

    <!-- Hero Section -->
    <div class="bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-500 rounded-3xl shadow-2xl p-8 mb-10 flex flex-col md:flex-row justify-between items-center gap-6">

        <div>
            <h1 class="text-4xl md:text-5xl font-bold text-white">
                🏡 Registered Houses
            </h1>

            <p class="text-blue-100 mt-3 text-lg">
                Explore beautiful homes available for rent.
            </p>
        </div>

        <a
            href="/"
            class="bg-white text-blue-700 hover:bg-blue-50 px-6 py-3 rounded-xl font-bold shadow-lg transition duration-300 hover:scale-105">
            🏠 Add Home
        </a>
        <a
            href="/user/favourite"
            class="bg-white text-blue-700 hover:bg-blue-50 px-6 py-3 rounded-xl font-bold shadow-lg transition duration-300 hover:scale-105">
            🏠 Go to Favourite
        </a>

        <a
            href="/user/booking"
            class="bg-white text-blue-700 hover:bg-blue-50 px-6 py-3 rounded-xl font-bold shadow-lg transition duration-300 hover:scale-105">
            🏠 Go to Booking
        </a>

    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">

        <% if(userData.length===0){ %>

        <div class="col-span-full text-center bg-white rounded-2xl shadow-lg p-16">

            <h2 class="text-3xl font-bold text-gray-700">
                😔 No Houses Registered
            </h2>

            <p class="text-gray-500 mt-3">
                Register your first house to see it listed here.
            </p>

            <a
                href="/"
                class="inline-block mt-6 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold transition">
                Register House
            </a>

        </div>

        <% } %>

        <% userData.forEach(Data=>{ %>

        <div class="bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-2 duration-300">

            <!-- Image -->
            <div class="relative">

                <img
                    src="https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=900"
                    alt="House"
                    class="w-full h-60 object-cover">

                <% if( !(bookedData.find((home)=> home.id === Data.id))  &&  (Data.available == 'on')  ){ %>

                <span class="absolute top-4 left-4 bg-green-600 text-white text-xs px-4 py-2 rounded-full shadow">
                    Available
                </span>

                <% } else { %>

                <span class="absolute top-4 left-4 bg-red-600 text-white text-xs px-4 py-2 rounded-full shadow">
                    Booked
                </span>

                <% } %>

               

            </div>
              <a
                            href="/host/showHome/<%= Data.id %>"
                            class="cursor-pointer px-4 py-2 rounded-lg border border-blue-200 text-purple-600 hover:bg-purple-600 hover:text-white transition font-medium">

                            Details

                        </a>


            <!-- Body -->
            <div class="p-6">

                <div class="flex justify-between items-start">

                    <div>

                        <h2 class="text-2xl font-bold text-gray-800">
                            <%= Data.houseName %>
                        </h2>

                        <p class="text-gray-500 mt-1">
                             <%= Data.location %>
                        </p>

                    </div>

                    <div class="text-right">

                        <p class="text-3xl font-bold text-blue-600">
                            ₹<%= Data.rent %>
                        </p>

                        <span class="text-gray-400 text-sm">
                            / month
                        </span>

                    </div>

                </div>

                <hr class="my-5">

                <div class="space-y-3 text-gray-700">

                    <p><span class="font-semibold">Owner:</span> <%= Data.owner %></p>

                    <p><span class="font-semibold">Bedrooms:</span> <%= Data.bedrooms %> BHK</p>

                    <p class="text-gray-600">
                        <%= Data.description %>
                    </p>

                </div>

                <!-- Professional Buttons -->
                <div class="mt-6 flex items-center justify-between border-t pt-5">

                    <!-- Save -->
                   <%- include("Partials/addFavourite",{Data:Data},{favouriteData:favouriteData}) %>
                   
                    <div class="flex gap-3">

                     <!-- Book -->


                     <% if( !(bookedData.find((home)=> home.id === Data.id))  &&  (Data.available == 'on')  ){ %>


                        <form
                            action="/user/bookHome/<%= Data.id %>"
                            method="POST">

                            <button
                                type="submit"
                                class="cursor-pointer px-4 py-2 rounded-lg border border-blue-200 text-yellow-600 hover:bg-yellow-600 hover:text-white transition font-medium">

                                Book

                            </button>

                        </form>

                        <% } %>


                        <!-- Edit -->
                        <a
                            href="/host/edit/<%= Data.id %>?editing=true"
                            class="cursor-pointer px-4 py-2 rounded-lg border border-blue-200 text-blue-600 hover:bg-blue-600 hover:text-white transition font-medium">

                            Edit

                        </a>

                        <!-- Delete -->
                        <form
                            action="/host/delete/<%= Data.id %>"
                            method="POST">

                            <button
                                type="submit"
                                class="cursor-pointer px-4 py-2 rounded-lg border border-red-200 text-red-600 hover:bg-red-600 hover:text-white transition font-medium">

                                Delete

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</main>

</body>

</html>