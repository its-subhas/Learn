<%- include('Partials/Head') %>

<body class="bg-slate-100 min-h-screen">

<%- include('Partials/Header') %>

<main class="max-w-7xl mx-auto px-6 py-10">

    <!-- Hero -->
    <section class="bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-500 rounded-3xl shadow-xl p-8 mb-10">

        <div class="flex flex-col lg:flex-row justify-between items-center gap-6">

            <div>

                <h1 class="text-4xl md:text-5xl font-bold text-white">
                    🏡 Registered Houses
                </h1>

                <p class="text-blue-100 mt-3 text-lg">
                    Discover premium houses available for rent.
                </p>

            </div>

            <a
                href="/host/showHome"
                class="bg-white text-blue-700 px-6 py-3 rounded-xl font-semibold shadow hover:bg-blue-50 transition duration-300">
                🏠 Go to Registered Houses
            </a>

        </div>

    </section>

    <!-- House Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

        <% if(userData.length===0){ %>

        <div class="col-span-full">

            <div class="bg-white rounded-2xl shadow-lg p-16 text-center">

                <h2 class="text-3xl font-bold text-gray-700">
                    😔 No Houses Registered
                </h2>

                <p class="text-gray-500 mt-4">
                    Register your first property to see it listed here.
                </p>

                <a
                    href="/"
                    class="inline-block mt-6 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-semibold transition">
                    Register House
                </a>

            </div>

        </div>

        <% } %>


        <% userData.forEach(Data=>{ %>

        <!-- Card -->
        <div class="max-w-sm mx-auto w-full bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-md hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 flex flex-col">

            <!-- Image -->
            <div class="relative">

                <img
                    src="https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=900"
                    alt="House"
                    class="w-full h-48 object-cover">

                <!-- Dark Overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>


               

                <span class="absolute top-3 left-3 bg-red-600 text-white text-xs font-semibold px-3 py-1 rounded-full shadow">
                    Booked
                </span>




            </div>


            <!-- Body -->
            <div class="p-5 flex flex-col flex-1">

                <!-- Title + Price -->
                <div class="flex justify-between items-start gap-3">

                    <div class="min-w-0">

                        <h2 class="text-xl font-bold text-gray-900 truncate">
                            <%= Data.bookHomeId.houseName %>
                        </h2>

                        <p class="text-sm text-gray-500 mt-1 truncate">
                            <%= Data.bookHomeId.location %>
                        </p>

                    </div>

                    <div class="text-right shrink-0">

                        <p class="text-2xl font-bold text-blue-600">
                            ₹<%= Data.bookHomeId.rent %>
                        </p>

                        <span class="text-xs text-gray-400">
                            per month
                        </span>

                    </div>

                </div>


                <div class="my-4 border-t"></div>


                <!-- Details -->
                <div class="space-y-2 text-sm text-gray-700">

                    <p>
                        👤
                        <span class="font-semibold">
                            Owner:
                        </span>
                        <%= Data.bookHomeId.owner %>
                    </p>

                    <p>
                        🛏️
                        <span class="font-semibold">
                            <%= Data.bookHomeId.bedrooms %> BHK
                        </span>
                    </p>

                    <p class="text-gray-600 line-clamp-2 min-h-[40px]">
                        <%= Data.bookHomeId.description %>
                    </p>

                </div>


                <!-- Buttons -->
               <!-- Buttons -->
<div class="grid grid-cols-2 gap-3 mt-auto pt-5">

    <!-- Details -->
    <a
        href="/host/showHome/<%= Data.bookHomeId._id %>"
        class="w-full text-center px-4 py-2 rounded-lg border border-purple-200 text-purple-600 hover:bg-purple-600 hover:text-white transition font-medium">

        Details

    </a>


    <!-- Cancel Booking -->
    <form
        action="/user/CancelBooking"
        method="POST"
        class="w-full">

        <input
            type="hidden"
            name="id"
            value="<%= Data.bookHomeId._id %>">

        <button
            type="submit"
            class="cursor-pointer w-full py-2 rounded-lg border border-red-300 text-red-600 hover:bg-red-600 hover:text-white text-sm font-medium transition-all duration-300">

            Cancel Booking

        </button>

    </form>

</div>

            </div>

        </div>

        <% }) %>

    </div>

</main>

</body>

</html>