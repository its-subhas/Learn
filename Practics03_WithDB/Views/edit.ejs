<%- include('Partials/Head') %>

<body class="bg-gray-100">

<%- include('Partials/Header') %>

<main class="bg-gray-100 min-h-[calc(100vh-70px)] flex items-center justify-center px-3 py-3">

  <div class="w-full max-w-3xl">

    <!-- Show Registered Houses -->
    <div class="flex items-center justify-center mb-3">

      <a
        href="/host/showHome"
        class="inline-flex items-center gap-1.5
               bg-green-600 hover:bg-green-700
               text-white px-3.5 py-1.5 rounded-md
               text-xs font-semibold shadow-sm transition"
      >
        📋 Show Registered Houses
      </a>

    </div>


    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-md p-4">

      <!-- Heading -->
      <h1 class="text-lg font-bold text-center text-blue-600 mb-4">
        🏠 <%= editing ? "Edit" : "Add" %> Your Home
      </h1>


      <form
        action="/host/edit/submited/<%= home._id %>"
        method="POST"
        enctype="multipart/form-data"
        class="space-y-3"
      >

        <!-- ================= ROW 1 ================= -->

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">

          <!-- House Photo -->
          <div>

            <label
              for="housePhoto"
              class="block text-xs font-semibold text-gray-700 mb-1"
            >
              House Photo
            </label>

            <input
              type="file"
              id="housePhoto"
              name="housePhoto"
              accept="image/*"
              class="block w-full h-8 text-xs text-gray-600
                     border border-gray-300 rounded-md
                     bg-white cursor-pointer
                     file:h-8 file:px-3 file:mr-3
                     file:border-0
                     file:border-r file:border-gray-300
                     file:bg-gray-50
                     file:text-gray-700
                     file:text-xs file:font-medium
                     hover:file:bg-gray-100
                     focus:outline-none focus:ring-1 focus:ring-blue-500"
            >

          </div>


          <!-- House Name -->
          <div>

            <label
              for="houseName"
              class="block text-xs font-semibold text-gray-700 mb-1"
            >
              House Name
            </label>

            <input
              type="text"
              id="houseName"
              name="houseName"
              value="<%= editing ? home.houseName : '' %>"
              placeholder="Enter house name"
              class="w-full h-8 border border-gray-300 rounded-md
                     px-2.5 text-xs
                     focus:outline-none focus:ring-1 focus:ring-blue-500"
              required
            >

          </div>

        </div>


        <!-- ================= ROW 2 ================= -->

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">

          <!-- Owner -->
          <div>

            <label
              for="owner"
              class="block text-xs font-semibold text-gray-700 mb-1"
            >
              Owner Name
            </label>

            <input
              type="text"
              id="owner"
              name="owner"
              value="<%= editing ? home.owner : '' %>"
              placeholder="Enter owner name"
              class="w-full h-8 border border-gray-300 rounded-md
                     px-2.5 text-xs
                     focus:outline-none focus:ring-1 focus:ring-blue-500"
              required
            >

          </div>


          <!-- Location -->
          <div>

            <label
              for="location"
              class="block text-xs font-semibold text-gray-700 mb-1"
            >
              Location
            </label>

            <input
              type="text"
              id="location"
              name="location"
              value="<%= editing ? home.location : '' %>"
              placeholder="Enter location"
              class="w-full h-8 border border-gray-300 rounded-md
                     px-2.5 text-xs
                     focus:outline-none focus:ring-1 focus:ring-blue-500"
              required
            >

          </div>

        </div>


        <!-- ================= ROW 3 ================= -->

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">

          <!-- Rent -->
          <div>

            <label
              for="rent"
              class="block text-xs font-semibold text-gray-700 mb-1"
            >
              Monthly Rent (₹)
            </label>

            <input
              type="number"
              id="rent"
              name="rent"
              value="<%= editing ? home.rent : '' %>"
              placeholder="Enter rent"
              class="w-full h-8 border border-gray-300 rounded-md
                     px-2.5 text-xs
                     focus:outline-none focus:ring-1 focus:ring-blue-500"
              required
            >

          </div>


          <!-- Bedrooms -->
          <div>

            <label
              for="bedrooms"
              class="block text-xs font-semibold text-gray-700 mb-1"
            >
              Bedrooms
            </label>

            <select
              id="bedrooms"
              name="bedrooms"
              class="w-full h-8 border border-gray-300 rounded-md
                     px-2.5 text-xs
                     focus:outline-none focus:ring-1 focus:ring-blue-500"
            >

              <option
                value="1"
                <%= editing ? (home.bedrooms == 1 ? 'selected' : '') : '' %>
              >
                1 BHK
              </option>

              <option
                value="2"
                <%= editing ? (home.bedrooms == 2 ? 'selected' : '') : '' %>
              >
                2 BHK
              </option>

              <option
                value="3"
                <%= editing ? (home.bedrooms == 3 ? 'selected' : '') : '' %>
              >
                3 BHK
              </option>

              <option
                value="4"
                <%= editing ? (home.bedrooms == 4 ? 'selected' : '') : '' %>
              >
                4+ BHK
              </option>

            </select>

          </div>

        </div>


        <!-- ================= ROW 4 ================= -->

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">

          <!-- Available -->
          <div class="flex items-center h-8">

            <label
              class="flex items-center gap-2
                     text-xs font-medium text-gray-700
                     cursor-pointer"
            >

              <input
                type="checkbox"
                id="available"
                name="available"
                value="on"
                <%= editing ? (home.available === 'on' ? 'checked' : '') : '' %>
                class="h-3.5 w-3.5"
              >

              Available for Rent

            </label>

          </div>

          <!-- Empty column -->
          <div></div>

        </div>


        <!-- ================= DESCRIPTION ================= -->

        <div>

          <label
            for="description"
            class="block text-xs font-semibold text-gray-700 mb-1"
          >
            Description
          </label>

          <textarea
            id="description"
            name="description"
            rows="2"
            placeholder="Describe the house"
            class="w-full border border-gray-300 rounded-md
                   px-2.5 py-1.5 text-xs resize-none
                   focus:outline-none focus:ring-1 focus:ring-blue-500"
          ><%= editing ? home.description : '' %></textarea>

        </div>


        <!-- ================= UPDATE ================= -->

        <button
          type="submit"
          class="w-full h-8
                 bg-blue-600 hover:bg-blue-700
                 text-white rounded-md
                 text-xs font-semibold
                 transition cursor-pointer"
        >
          Update
        </button>

      </form>

    </div>

  </div>

</main>

</body>

</html>