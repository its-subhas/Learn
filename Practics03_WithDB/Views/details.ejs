<%- include('Partials/Head') %>

<body class="bg-slate-100 min-h-screen">

<%- include('Partials/Header') %>

<main class="max-w-3xl mx-auto px-3 py-5">

  <div class="bg-white rounded-xl overflow-hidden shadow-md">

    <!-- Image -->
    <div class="relative">

      <img
        src="<%= details.housePhoto %>"
        alt="<%= details.houseName %>"
        class="w-full h-64 object-cover"
      >

      <!-- Availability -->
      <% if (
        !allBooking.find(
          home =>
            home.bookHomeId &&
            home.bookHomeId._id &&
            home.bookHomeId._id.toString() === details._id.toString()
        ) &&
        details.available === "on"
      ) { %>

        <span class="absolute top-3 left-3 bg-green-600 text-white text-xs px-3 py-1 rounded-full shadow">
          Available
        </span>

      <% } else { %>

        <span class="absolute top-3 left-3 bg-red-600 text-white text-xs px-3 py-1 rounded-full shadow">
          Booked
        </span>

      <% } %>

    </div>


    <!-- Body -->
    <div class="p-5">

      <!-- Title + Rent -->
      <div class="flex items-start justify-between gap-4">

        <div>

          <h1 class="text-xl font-bold text-gray-800">
            <%= details.houseName %>
          </h1>

          <p class="text-xs text-gray-500 mt-1">
         <%= details.location %>
          </p>

        </div>

        <div class="text-right shrink-0">

          <p class="text-xl font-bold text-blue-600">
            ₹<%= details.rent %>
          </p>

          <span class="text-xs text-gray-400">
            / month
          </span>

        </div>

      </div>


      <hr class="my-4">


      <!-- Details Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">

        <div class="bg-gray-50 rounded-md px-3 py-2">
          <span class="font-semibold text-gray-600">
            Owner:
          </span>

          <span class="text-gray-800">
            <%= details.owner %>
          </span>
        </div>


        <div class="bg-gray-50 rounded-md px-3 py-2">
          <span class="font-semibold text-gray-600">
            Bedrooms:
          </span>

          <span class="text-gray-800">
            <%= details.bedrooms %> BHK
          </span>
        </div>

      </div>


      <!-- Description -->
      <div class="mt-3">

        <p class="text-xs font-semibold text-gray-600 mb-1">
          Description
        </p>

        <p class="text-xs text-gray-600 leading-5">
          <%= details.description %>
        </p>

      </div>


      <!-- Buttons -->
      <div class="mt-5 pt-4 border-t flex items-center justify-between gap-3">


        <!-- Favourite -->
        <% if (
          favouriteData &&
          favouriteData.find(
            home =>
              home.homeId &&
              home.homeId._id &&
              home.homeId._id.toString() === details._id.toString()
          )
        ) { %>

          <!-- Already Favourite -->
          <form action="/user/addFavouriteDetails" method="POST">

            <input
              type="hidden"
              name="id"
              value="<%= details._id %>"
            >

            <button
              type="submit"
              title="Remove from favourites"
              class="flex items-center gap-1.5 text-red-500 hover:text-red-600 text-xs font-semibold transition cursor-pointer"
            >

              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 fill-red-500"
                viewBox="0 0 24 24"
              >
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5A5.5 5.5 0 017.5 3 5.5 5.5 0 0112 5.09 5.5 5.5 0 0116.5 3 5.5 5.5 0 0122 8.5c0 3.78-3.4 6.86-8.55 11.54z"/>
              </svg>

              Favourite

            </button>

          </form>


        <% } else { %>

          <!-- Not Favourite -->
          <form action="/user/addFavouriteDetails" method="POST">

            <input
              type="hidden"
              name="id"
              value="<%= details._id %>"
            >

            <button
              type="submit"
              title="Add to favourites"
              class="flex items-center gap-1.5 text-gray-500 hover:text-red-500 text-xs font-semibold transition cursor-pointer"
            >

              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5A5.5 5.5 0 0112 5.09 5.5 5.5 0 0116.5 3 5.5 5.5 0 0122 8.5c0 3.78-3.4 6.86-8.55 11.54z"/>
              </svg>

              Favourite

            </button>

          </form>

        <% } %>


        <!-- Booking -->
        <% if (
          allBooking &&
          allBooking.find(
            home =>
              home.bookHomeId &&
              home.bookHomeId._id &&
              home.bookHomeId._id.toString() === details._id.toString()
          )
        ) { %>

          <!-- Cancel Booking -->
          <form
            action="/user/CancelBooking/details"
            method="POST"
          >

            <input
              type="hidden"
              name="id"
              value="<%= details._id %>"
            >

            <button
              type="submit"
              class="px-4 py-1.5 rounded-md bg-red-600 hover:bg-red-700 text-white text-xs font-semibold transition cursor-pointer"
            >
              Cancel Booking
            </button>

          </form>


        <% } else if (details.available === "on") { %>

          <!-- Book -->
          <form
            action="/user/bookHome/<%= details._id %>"
            method="POST"
          >

            <button
              type="submit"
              class="px-4 py-1.5 rounded-md bg-yellow-500 hover:bg-yellow-600 text-white text-xs font-semibold transition cursor-pointer"
            >
              Book Now
            </button>

          </form>


        <% } else { %>

          <span class="text-xs font-semibold text-red-500">
            Home Not Available
          </span>

        <% } %>

      </div>

    </div>

  </div>

</main>

</body>

</html>