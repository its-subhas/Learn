<%- include('Partials/Head') %>

<body class="bg-slate-100 min-h-screen">

<%- include('Partials/Header') %>

<main class="max-w-6xl mx-auto px-3 sm:px-5 py-5">

    <!-- Hero Section -->
    <div class="bg-gradient-to-r from-blue-700 via-blue-600 to-cyan-500 rounded-2xl shadow-lg p-4 sm:p-5 mb-6 flex flex-col lg:flex-row justify-between items-center gap-3">

        <div class="text-center lg:text-left">
            <h1 class="text-2xl md:text-3xl font-bold text-white">
                🏡 Registered Houses
            </h1>

            <p class="text-blue-100 mt-1 text-sm">
                Explore beautiful homes available for rent.
            </p>
        </div>


        <div class="flex flex-wrap justify-center gap-2">

            <% if(isLogin && user && user.usertype === 'admin') { %>

            <a
                href="/"
                class="bg-white text-blue-700 hover:bg-blue-50 px-3 py-1.5 rounded-md text-xs font-semibold shadow-sm transition"
            >
                🏠 Add Home
            </a>

            <% } else { %>

            <a
                href="/"
                class="bg-white text-blue-700 hover:bg-blue-50 px-3 py-1.5 rounded-md text-xs font-semibold shadow-sm transition"
            >
                🏠 Home
            </a>

            <% } %>


<a
  href="/user/favourite"
  class="inline-flex items-center gap-2 bg-white text-blue-700
         hover:bg-blue-50 px-3 py-1.5 rounded-md text-xs
         font-semibold shadow-sm transition"
  title="View favourites"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    class="w-4 h-4 text-red-500"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5
         -1.935 0-3.597 1.126-4.312 2.733
         C11.285 4.876 9.623 3.75 7.688 3.75
         5.099 3.75 3 5.765 3 8.25
         c0 7.22 9 11.25 9 11.25s9-4.03 9-11.25Z"
    />
  </svg>

  Favourite
</a>


            <a
                href="/user/booking"
                class="bg-white text-blue-700 hover:bg-blue-50 px-3 py-1.5 rounded-md text-xs font-semibold shadow-sm transition"
            >
                📅 Booking
            </a>

        </div>

    </div>


    <!-- Houses Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">

        <% if(userData.length===0){ %>

        <div class="col-span-full text-center bg-white rounded-xl shadow-md p-8">

            <h2 class="text-xl font-bold text-gray-700">
                😔 No Houses Registered
            </h2>

            <% if(isLogin && user && user.usertype === 'admin') { %>

            <p class="text-gray-500 mt-2 text-sm">
                Register your first house to see it listed here.
            </p>

            <a
                href="/"
                class="inline-block mt-4 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-semibold transition"
            >
                Register House
            </a>

            <% } %>

        </div>

        <% } %>


        <% userData.forEach(Data=>{ %>

        <!-- House Card -->
        <div class="bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg hover:-translate-y-1 duration-200">

            <!-- Image -->
            <div class="relative">

                <img
                    src="<%= Data.housePhoto %>"
                    alt="House"
                    class="w-full h-40 object-cover"
                >


                <% if( !(bookedData.find((home)=> home.bookHomeId._id.toString() === Data._id.toString())) && (Data.available == 'on') ){ %>

                <span class="absolute top-2 left-2 bg-green-600 text-white text-[10px] px-2.5 py-1 rounded-full shadow-sm">
                    Available
                </span>

                <% } else { %>

                <span class="absolute top-2 left-2 bg-red-600 text-white text-[10px] px-2.5 py-1 rounded-full shadow-sm">
                    Booked
                </span>

                <% } %>

            </div>


            <!-- Body -->
            <div class="p-4">

                <!-- Title + Rent -->
                <div class="flex justify-between items-start gap-3">

                    <div class="min-w-0">

                        <h2 class="text-lg font-bold text-gray-800 truncate">
                            <%= Data.houseName %>
                        </h2>

                        <p class="text-gray-500 text-xs mt-0.5 truncate">
                           <%= Data.location %>
                        </p>

                    </div>


                    <div class="text-right shrink-0">

                        <p class="text-lg font-bold text-blue-600">
                            ₹<%= Data.rent %>
                        </p>

                        <span class="text-gray-400 text-[10px]">
                            / month
                        </span>

                    </div>

                </div>


                <!-- Details -->
                <div class="mt-3">

                    <a
                        href="/host/showHome/<%= Data._id %>"
                        class="inline-block px-3 py-1 rounded-md border border-purple-200 text-purple-600 hover:bg-purple-600 hover:text-white transition text-xs font-medium"
                    >
                        Details
                    </a>

                </div>


                <hr class="my-3">


                <!-- Information -->
                <div class="space-y-1.5 text-xs text-gray-700">

                    <p>
                        <span class="font-semibold">Owner:</span>
                        <%= Data.owner %>
                    </p>

                    <p>
                        <span class="font-semibold">Bedrooms:</span>
                        <%= Data.bedrooms %> BHK
                    </p>

                    <p class="text-gray-500 line-clamp-2">
                        <%= Data.description %>
                    </p>

                </div>


                <!-- Bottom Buttons -->
                <div class="mt-4 pt-3 border-t flex items-center justify-between gap-2">

                    <!-- Favourite -->
                    <div>
                        <%- include("Partials/addFavourite", {userData: Data, favouriteData: favouriteData}) %>
                    </div>


                    <!-- Actions -->
                    <div class="flex flex-wrap justify-end gap-1.5">

                        <!-- Book -->

                        <% if( !(bookedData.find((home)=> home.bookHomeId._id.toString() === Data._id.toString())) && (Data.available == 'on') ){ %>

                        <form
                            action="/user/bookHome/<%= Data._id %>"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="cursor-pointer px-3 py-1 rounded-md border border-yellow-200 text-yellow-600 hover:bg-yellow-600 hover:text-white transition text-xs font-medium"
                            >
                                Book
                            </button>

                        </form>

                        <% } %>


                        <% if(isLogin && user && user.usertype === 'admin') { %>

                        <!-- Edit -->
                        <a
                            href="/host/edit/<%= Data._id %>?editing=true"
                            class="cursor-pointer px-3 py-1 rounded-md border border-blue-200 text-blue-600 hover:bg-blue-600 hover:text-white transition text-xs font-medium"
                        >
                            Edit
                        </a>


                        <!-- Delete -->
                        <form
                            action="/host/delete/<%= Data._id %>"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="cursor-pointer px-3 py-1 rounded-md border border-red-200 text-red-600 hover:bg-red-600 hover:text-white transition text-xs font-medium"
                            >
                                Delete
                            </button>

                        </form>

                        <% } %>

                    </div>

                </div>

            </div>

        </div>

        <% }) %>

    </div>

</main>

</body>

</html>